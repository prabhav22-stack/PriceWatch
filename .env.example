# ==============================================================================
# Telegram PriceWatch Bot - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your values. NEVER commit .env to version control!

# --- Telegram Bot Configuration ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_USER_IDS=123456789,987654321

# --- Supabase Database Configuration ---
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key
# Direct Postgres Connection URL (optional for direct pool/alembic migrations):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# --- Application Settings ---
APP_ENV=development # development | staging | production
LOG_LEVEL=INFO
SCRAPE_INTERVAL_MINUTES=60
MAX_ITEMS_PER_USER=20
REQUEST_TIMEOUT_SECONDS=15
USER_AGENT=PriceWatchBot/1.0 (+https://t.me/your_bot_username)

# --- Alert & Rate Limiting ---
ALERT_COOLDOWN_HOURS=6
MAX_RETRIES=3
